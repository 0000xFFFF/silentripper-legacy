#!/usr/bin/env python3

import argparse
import sys
import glob
import os

from tabulate import tabulate

from helpers import get_video_duration, format_time

def main():
    parser = argparse.ArgumentParser(
        description="Sum total duration of video files (supports wildcards like *cut*.mp4)"
    )
    parser.add_argument("files", nargs="+", help="Video files (wildcards allowed)")
    parser.add_argument('-v', '--verbose', action='store_true', help="print files that are read")
    parser.add_argument('-x2', '--half_time', action='store_true', help="calc half time at the end")
    args = parser.parse_args()

    # Expand wildcards manually (glob)
    file_list = []
    for pattern in args.files:
        matches = glob.glob(pattern)
        if matches:
            file_list.extend(matches)
        else:
            file_list.append(pattern)

    if not file_list:
        print("❌ No matching files found.", file=sys.stderr)
        sys.exit(1)

    total = 0

    table = []
    for file in file_list:
        if os.path.isfile(file):
            duration = 0
            try:
                duration = get_video_duration(file)
            except:
                continue
            total += duration
            if args.verbose:
                table.append([file, format_time(duration), duration])

    if args.verbose:
        print(tabulate(table, headers=["File","Duration", "Seconds"]))


    print(f"Total duration....: {format_time(total)} ({total:.2f} seconds)")

    if args.half_time:
        half = total/2
        print(f"x2 (half) duration: {format_time(half)} ({half:.2f} seconds)")

if __name__ == "__main__":
    main()

